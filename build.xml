<?xml version="1.0" encoding="UTF-8"?>
<project name="FrozenFoodApp" default="run" basedir=".">
    <description>Builds, tests, and runs the FrozenFoodApp project</description>
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="build.classes.dir" value="${build.dir}/classes"/>
    <property name="dist.jar" value="${dist.dir}/FrozenFoodApp.jar"/>
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}"/>
    </target>
    <target name="jar" depends="compile">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="frozenfoodapp.FrozenFoodApp"/>
            </manifest>
        </jar>
    </target>
    <target name="run" depends="jar">
        <java jar="${dist.jar}" fork="true"/>
    </target>
</project>
